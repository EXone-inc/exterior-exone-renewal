# =============================================================
# WordPress (Local by Flywheel) — 自作コードだけを追跡する構成
#
# 方針: deny-all + allowlist
#   既定ですべて無視し、追跡したいものだけ "!" で許可する。
#   WP 本体・プラグイン・アップロード画像・DB は Git に載せない
#   （本体とプラグインは管理画面で更新される＝Git と競合するため）。
#
# 追跡する : 自作テーマ / 自作プラグイン / ドキュメント
# 追跡しない: WordPress 本体, wp-config.php, uploads, 既定テーマ, ログ, DB ダンプ
# =============================================================

# -------------------------------------------------------------
# 1) 既定ですべて無視
#    ルート直下（wp-admin/ wp-includes/ wp-*.php wp-config.php
#    .htaccess index.php xmlrpc.php local-xdebuginfo.php
#    .claude/ .codex/ .mcp.json 等）はここで全部落ちる
# -------------------------------------------------------------
/*

# -------------------------------------------------------------
# 2) リポジトリ運用に必要なファイルだけ復活
# -------------------------------------------------------------
!.gitignore
!README.md
!CLAUDE.md
!/docs/

# -------------------------------------------------------------
# 3) wp-content は themes / plugins / mu-plugins だけ有効化
#    （uploads/ upgrade/ cache/ languages/ backup 系は無視のまま）
# -------------------------------------------------------------
!/wp-content/
/wp-content/*

# themes 配下は既定で追跡（自作テーマを増やしても追記不要）
!/wp-content/themes/

# plugins / mu-plugins は「名指しで許可」方式（サードパーティを載せないため）
!/wp-content/plugins/
/wp-content/plugins/*
!/wp-content/mu-plugins/
/wp-content/mu-plugins/*

# -------------------------------------------------------------
# 4) WordPress 同梱の既定テーマは追跡しない
# -------------------------------------------------------------
/wp-content/themes/twenty*/

# 親テーマ等、サードパーティ製テーマを追跡したくない場合はここに追記
# 例: /wp-content/themes/affinger/

# -------------------------------------------------------------
# 5) 自作プラグインを作ったらここに追記して許可
# -------------------------------------------------------------
# 例: !/wp-content/plugins/exone-custom/
# 例: !/wp-content/mu-plugins/exone-mu.php

# -------------------------------------------------------------
# 6) 追跡対象の中でも無視するもの
# -------------------------------------------------------------
# 認証情報・環境設定（絶対にコミットしない）
**/.env
**/.env.*
**/*.pem
**/*.key
**/wp-config-local.php

# 依存・ビルド生成物
**/node_modules/
**/vendor/
!**/js/vendor/
**/.sass-cache/
**/*.map
**/.parcel-cache/
**/dist-cache/

# バックアップ / DB ダンプ / アーカイブ
*.BAK-*
*.OLD-*
**/*.bak
**/*.orig
**/*.sql
**/*.sql.gz
**/*.zip
**/*.tar.gz

# ログ・デバッグ
**/*.log
**/debug.log
**/error_log

# OS・エディタ生成ファイル
**/.DS_Store
Thumbs.db
desktop.ini
**/*.swp
**/*.swo
**/*~
.idea/
.vscode/
